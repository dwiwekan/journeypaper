# Copy to .env for local development. Copy to .env.prod for Supabase (Task 8).
# Never commit .env or .env.prod.

# The API connects as journey_app (no DDL rights).
DATABASE_URL=postgresql+psycopg://journey_app:dev@localhost:5433/journey
# Alembic connects as the owner role.
MIGRATE_DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5433/journey
# Tests create and drop their own database through this URL.
TEST_DATABASE_ADMIN_URL=postgresql+psycopg://postgres:dev@localhost:5433/postgres

SUPABASE_URL=https://xxgdylyvbbohjpibwucv.supabase.co
# Comma-separated emails that get role "admin".
ADMIN_EMAILS=
CORS_ORIGINS=http://localhost:8000

# Role passwords, set on the database with `make set-passwords-prod`.
JOURNEY_APP_PASSWORD=
JOURNEY_BACKUP_PASSWORD=
